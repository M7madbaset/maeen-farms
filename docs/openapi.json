{
  "components": {
    "schemas": {
      "Fault": {
        "additionalProperties": false,
        "properties": {
          "factor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Factor"
          },
          "fault": {
            "enum": [
              "leak",
              "leak_downstream",
              "pump_degraded",
              "filter_clogged",
              "meter_mismatch",
              "valve_stuck_closed",
              "valve_stuck_open",
              "stale_sensor",
              "offline_sensor",
              "pump_fault",
              "open_valve",
              "sensor_bias"
            ],
            "title": "Fault",
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          }
        },
        "required": [
          "fault"
        ],
        "title": "Fault",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Outcome": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "default": "",
            "maxLength": 500,
            "title": "Note",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "leak_confirmed",
              "sensor_fault_confirmed",
              "equipment_fault_confirmed",
              "false_alarm"
            ],
            "title": "Outcome",
            "type": "string"
          }
        },
        "required": [
          "outcome"
        ],
        "title": "Outcome",
        "type": "object"
      },
      "Reject": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "default": "",
            "maxLength": 300,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "Reject",
        "type": "object"
      },
      "StartAnomaly": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "title": "Event Id",
            "type": "string"
          },
          "expected_flow_m3h": {
            "exclusiveMinimum": 0.0,
            "maximum": 500.0,
            "title": "Expected Flow M3H",
            "type": "number"
          },
          "valve_id": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Valve Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "valve_id",
          "expected_flow_m3h"
        ],
        "title": "StartAnomaly",
        "type": "object"
      },
      "StartWater": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "event_id"
        ],
        "title": "StartWater",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "SIMULATION-ONLY API for MAeen FarmOS slices 1-5.",
