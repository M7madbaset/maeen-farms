# Placeholders only - no secrets. Slices 1-3 read no environment variables.
MAEEN_MODE=simulation
MAEEN_DB_PASSWORD=change-me-locally            # used by docker-compose.yml
MAEEN_DATABASE_URL=host=localhost port=5432 user=maeen password=change-me-locally dbname=maeen
# Tests only (needs CREATE DATABASE rights):
# MAEEN_TEST_PG_ADMIN_DSN=host=localhost port=5432 user=maeen password=change-me-locally dbname=postgres
# Future: MQTT_URL=, LLM_PROVIDER=, LLM_API_KEY=  (use a secrets manager, never commit)

# API (slice 5) - required to run `python -m maeen.serve`
# MAEEN_JWT_SECRET=                      # >= 32 random chars:  openssl rand -hex 32   (never commit)
# MAEEN_DB_PATH=maeen.db
# MAEEN_DEV_USERS_PASSWORD=              # DEV ONLY: creates owner1, agro1, op1, aud1, fin1, admin1 with this password
# MAEEN_ENABLE_DOCS=1                    # exposes /docs and /openapi.json (off by default)
